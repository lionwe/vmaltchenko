                        "label": "Значення картки",
                        "name": "card_value",
                        "type": "text",
                        "default_value": "+10 років"
                    }
                ]
            },
            {
                "key": "field_about_grid_text",
                "label": "Текст в гріді (4-й елемент)",
                "name": "about_grid_text",
