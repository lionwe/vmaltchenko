                "library": "all",
                "instructions": "Оберіть зображення у форматі WebP"
            },
            {
                "key": "field_about_badge",
                "label": "Бейджик",
                "name": "about_badge",
                "type": "text",
                "default_value": "Хто я?"
            },
            {
                "key": "field_about_main_content",
                "label": "Головний контент",
                "name": "about_main_content",
                "type": "wysiwyg",
                "tabs": "all",
                "toolbar": "full",
                "media_upload": 0,
                "instructions": "Заголовок (H2) та опис"
            },
            {
                "key": "field_about_cards",
                "label": "Карточки досвіду",
                "name": "about_cards",
